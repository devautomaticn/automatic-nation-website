---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import { asset } from '../lib/url';
import type { Cta } from '../lib/design';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Path with no leading slash and no base — feeds canonical and OG. */
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  article?: { published: Date; modified?: Date; author?: string; tags?: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Paths under public/ to emit as <link rel="preload" as="image">.
   *
   * This is a layout prop rather than something the hero emits itself because
   * Astro does not hoist <head> content out of a nested component, and a
   * preload discovered down in <body> has already lost the race it exists to
   * win. The one line in a page's frontmatter is the honest cost, and it keeps
   * "this page pays for the well" visible at the call site.
   */
  preloadImages?: readonly string[];
  nav?: boolean;
  footer?: boolean;
  /**
   * Chrome link overrides, forwarded to Nav and Footer.
   *
   * A page that does NOT contain the home page's #templates/#process/#faq
   * sections must pass the -AWAY variants from src/lib/site.ts, or its navbar
   * silently goes nowhere — a bare '#process' resolves against the current url.
   * See the block comment on NAV in site.ts.
   */
  navLinks?: readonly { label: string; href: string }[];
  footerLinks?: readonly { label: string; href: string }[];
  navCta?: Cta | false;
  class?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = '',
  ogImage,
  ogType,
  noindex,
  article,
  jsonLd,
  preloadImages = [],
  nav = true,
  footer = true,
  navLinks,
  footerLinks,
  navCta,
  class: className,
} = Astro.props as Props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <Seo {title} {description} {path} {ogImage} {ogType} {noindex} {article} {jsonLd} />

  <!-- Fonts: display + body + JetBrains Mono for eyebrows and captions.
       preconnect saves a round trip — the stylesheet alone can't start the
       font fetch until it has resolved and parsed. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Montserrat:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  {preloadImages.map(src => <link rel="preload" as="image" href={asset(src)} />)}
</head>
<body class={className}>
  {nav && <Nav links={navLinks} cta={navCta} />}
  <slot />
  {footer && <Footer links={footerLinks} />}

  <!-- Smooth scrolling. Site-wide and deliberately separate from any hero
       script: bundling them together would make every page that has no well
       still pull the well's module graph. -->
  <script>
    import { initSmoothScroll } from '../scripts/smooth-scroll.js';
    initSmoothScroll();
  </script>

  <!-- Reveal-on-scroll. Inline because it is nine lines with no imports, and
       inlining keeps it ahead of the bundled modules. The reduced-motion case
       is handled in CSS, which unsets .reveal's initial opacity.

       threshold MUST stay 0. It used to be 0.12 — "reveal once 12% of it is
       showing" — but IntersectionObserver measures that ratio against the
       ELEMENT, not the viewport, so for anything taller than ~8x the viewport
       the ratio tops out below 0.12 and the callback never fires at all. The
       element then keeps .reveal's opacity:0 forever. That silently hid all 57
       cards in the blog index's 2025 group, with the year heading still
       visible above the blank space.

       rootMargin is what the 0.12 was reaching for: trigger when the element
       crosses 12% up from the bottom edge of the viewport. That reads the same
       on a normal section and, unlike a threshold, cannot become unreachable. -->
  <script is:inline>
    const _revealObserver = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          _revealObserver.unobserve(e.target);
        }
      }
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('.reveal').forEach(el => _revealObserver.observe(el));
  </script>
</body>
</html>
