---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CalEmbed from '../components/sections/CalEmbed.astro';
import { NAV_AWAY, FOOTER_LINKS_AWAY } from '../lib/site';
import { asset, pageUrl } from '../lib/url';
import { breadcrumbs } from '../lib/jsonld';

/**
 * The booking page. Every "Book a call" CTA on the site points here — see
 * BOOKING in src/lib/site.ts — rather than at cal.com directly, so the most
 * important step on the site keeps a URL on this domain.
 *
 * The slug was already in RESERVED_SLUGS before this file existed: it is a
 * root-level route, and the root namespace belongs to the 61 migrated posts.
 * Nothing to add there, but nothing to remove either.
 *
 * navCta is '#book' rather than BOOKING: a "Book a call" button that reloads
 * the page you are already on is a dead control. Here it scrolls to the well.
 */
const nav = { label: 'Book a call', href: '#book', external: false };
const url = pageUrl('book-a-call', Astro.site);

/**
 * Mike's headshot. Already in public/ because the hero well drops it as a tile
 * (see PHOTOS in src/lib/hero-assets.ts) — same file, no second copy. It is
 * 400x400 on the brand yellow, so it needs no background treatment here.
 */
const PORTRAIT = 'image.png';
---
<BaseLayout
  title="Book a call — Automatic Nation"
  description="Pick a time for a 30-minute call. Tell us what your team does by hand and we'll tell you what it costs to stop."
  path="book-a-call/"
  jsonLd={breadcrumbs([
    { name: 'Home', url: pageUrl('', Astro.site) },
    { name: 'Book a call', url },
  ])}
  navLinks={NAV_AWAY}
  footerLinks={FOOTER_LINKS_AWAY}
  navCta={nav}
  preloadImages={[PORTRAIT]}
>
  <Section size="lg" container={false}>
    <Container width="narrow">
      {/* Copy first in the source, on every viewport: the heading should lead
          for a screen reader and for the crawler, and the portrait is context,
          not the point. On mobile the row simply stacks in that order. */}
      <div class="flex flex-col md:flex-row md:items-start gap-10">
        <div class="flex-1 min-w-0">
          <SectionHeader
            eyebrow="Book a call"
            title="Grab 30 minutes."
            lead="Bring the process that eats the most hours. We'll map it live and tell you what it takes to automate — scope, timeline and price. No pitch deck, no obligation."
            level={2}
            scale="display-md"
            width="full"
          />
        </div>

        <figure class="book-portrait reveal">
          <img src={asset(PORTRAIT)} alt="Mike Simmons" width="400" height="400" />
          <figcaption>You'll be talking to Mike.</figcaption>
        </figure>
      </div>
    </Container>
  </Section>

  <CalEmbed />
</BaseLayout>
