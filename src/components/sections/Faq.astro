---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  items: FaqItem[];
}

const { id, eyebrow, title, items } = Astro.props as Props;
---
{/* The FAQPage JSON-LD is NOT emitted here. It has to appear on exactly one
    URL — two pages carrying the same FAQPage is a duplicate-content signal —
    and a section component can't know whether it's the canonical one. The page
    passes faqPage(items) to BaseLayout's jsonLd instead. */}
<Section {id}>
  <SectionHeader {eyebrow} {title} />

  <div class="mt-block grid grid-cols-1 md:grid-cols-3 gap-px bg-line border border-line reveal">
    {items.map(item => (
      <Card pad="lg">
        <h3 class="text-lg font-semibold tracking-[-0.02em]">{item.q}</h3>
        <p class="mt-3 text-sm text-mute leading-relaxed">{item.a}</p>
      </Card>
    ))}
  </div>
</Section>
