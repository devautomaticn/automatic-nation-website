---
import { asset, absolute, pageUrl } from '../../lib/url';
import { SITE } from '../../lib/site';

/**
 * Every <head> tag that depends on the page. The only place a URL gets
 * absolutised — `Astro.site` is the bare origin, so anything built with
 * `new URL(path, Astro.site)` silently loses the deployment base.
 */
interface Props {
  title: string;
  description: string;
  /** Path with no leading slash and no base: '', 'blog', 'blog/my-post'. */
  path?: string;
  /** Path under public/. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  article?: { published: Date; modified?: Date; author?: string; tags?: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = '',
  ogImage = 'og-image.png',
  ogType = 'website',
  noindex = false,
  article,
  jsonLd,
} = Astro.props as Props;

// pageUrl for the page (trailing slash, matching `trailingSlash: 'always'`),
// absolute for the image (an asset — a trailing slash would break it).
const canonical = pageUrl(path, Astro.site);
const image = absolute(ogImage, Astro.site);
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* The site's own mark — the same path Nav.astro renders in the header, which
    is the only vector source for it. public/favicon.svg used to be Astro's stock
    logo; it is now this. The SVG carries a prefers-color-scheme rule so the mark
    inverts on a dark tab strip, which a PNG cannot do — hence the ico and PNGs
    are ink-on-paper tiles, safe on either background, and serve as the fallback
    for browsers that ignore SVG icons.
    An HTML comment here would ship on all 140 pages; this one does not. */}
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
<link rel="icon" href={asset('favicon.ico')} sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href={asset('favicon-32.png')} sizes="32x32" />
<link rel="icon" type="image/png" href={asset('favicon-192.png')} sizes="192x192" />
<link rel="apple-touch-icon" href={asset('favicon-180.png')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href={asset('rss.xml')} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="Automatic Nation" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{article && (
  <>
    <meta property="article:published_time" content={article.published.toISOString()} />
    {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.tags?.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

{blocks.map(block => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
