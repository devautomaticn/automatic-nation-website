---
import Button from '../ui/Button.astro';
import { BASE } from '../../lib/url';
import { NAV, BOOKING, SITE } from '../../lib/site';
import type { Cta } from '../../lib/design';

interface Props {
  /** Override the default "Book a call" action. */
  cta?: Cta | false;
  links?: readonly { label: string; href: string }[];
}

const { cta, links = NAV }: Props = Astro.props;
const action = cta === undefined
  ? { label: 'Book a call', href: BOOKING.href, external: BOOKING.external }
  : cta;
---
<header class="navbar">
  {/* Inner container so the bottom rule stays full-bleed (like every section
      border on the page) while the contents sit on the same page measure as
      the hero and the sections. */}
  <div class="navbar-inner">
    <a href={`${BASE}/`} class="logo">
      <svg width="32" height="31" viewBox="0 0 32 31" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M11.6217 0C11.7142 0.000353627 11.7891 0.0752685 11.7895 0.167763V21.8947H13.4737V12.125L20.2105 0H21.8947V21.8947H23.5789V12.125L30.3158 0H32V15.1579H30.3158L21.8947 30.3158H20.2105V15.1579L11.7895 30.3158H10.1053V15.8076C10.105 15.6342 9.87405 15.5741 9.78947 15.7253L1.73191 30.2286C1.70227 30.282 1.64653 30.3156 1.58553 30.3158H0.167763C0.0752688 30.3154 0.000354051 30.2405 0 30.148V15.3257C0.000354057 15.2332 0.0752688 15.1582 0.167763 15.1579H1.58553C1.64653 15.1577 1.70227 15.1241 1.73191 15.0707L10.0576 0.087171C10.0872 0.0338245 10.1429 0.00014998 10.2039 0H11.6217Z" fill="currentColor"/>
      </svg>
      <span class="logo-text">{SITE.name}</span>
    </a>

    <nav class="nav-links" aria-label="Main">
      {links.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>

    {action && (
      <Button href={action.href} external={action.external} size="md">{action.label}</Button>
    )}
  </div>
</header>
