# Astro build output
dist/

# Astro cache
.astro/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Env files (never commit secrets)
.env
.env.local
.env.*

# Claude Code config — local settings stay local, but the SEO pipeline's skills
# are shared work: they ARE the pipeline (see seo/README.md), and a skill that
# only exists on one laptop is a stage nobody else can run.
#
# `.claude/*`, not `.claude/` — git will not re-include anything inside a
# directory it has already excluded, so the negation below only works if the
# directory itself is never excluded.
.claude/*
!.claude/skills/

# Draft / prototype HTML files (not part of the Astro project)
index.html
automatic-nation-landing.html
automatic-nation-final.html

# Root-level asset duplicates (originals live in public/)
# Leading slash anchors these to the repo root so they do NOT also match the
# originals under public/ — those must be committed or the live build 404s.
/logos/
/image.png
/T024D9G3RV4-U05ENL69F37-458b1cdf045b-512.jpg

# Design-tool exports (the spec that matters lives in docs/design/)
*.zip

# Generated reports
competitor-analysis-report.md
