---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { SITE, FOOTER_LINKS } from '../../lib/site';

interface Props {
  links?: readonly { label: string; href: string }[];
}

const { links = FOOTER_LINKS } = Astro.props as Props;
const year = 2026;
const place = SITE.city || '[CITY]';
---
<footer class="bg-ink text-dim border-t border-line-dk">
  <Container class="py-section-sm grid grid-cols-1 md:grid-cols-3 gap-10">
    <div>
      <div class="font-sans font-bold tracking-[-0.02em] text-lg text-paper">{SITE.name}</div>
      <p class="mt-3 text-xs">{SITE.tagline}</p>
      <p class="mt-6 font-mono text-2xs text-faint">est. {SITE.founded}</p>
    </div>

    <div class="md:justify-self-center">
      <Eyebrow tone="faint" class="mb-4">Sitemap</Eyebrow>
      <ul class="space-y-2 text-xs">
        {links.map(item => (
          <li><a href={item.href} class="link-u hover:text-paper">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:justify-self-end">
      <Eyebrow tone="faint" class="mb-4">Get in touch</Eyebrow>
      <a href={`mailto:${SITE.email}`} class="link-u text-sm text-paper">{SITE.email}</a>
      {SITE.linkedin && (
        <div class="mt-4 flex items-center gap-3">
          <a
            href={SITE.linkedin}
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener"
            class="border border-line-dk rounded-chip p-2 hover:text-paper transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      )}
    </div>
  </Container>

  <div class="border-t border-line-dk">
    <Container class="py-section-xs">
      <p class="font-mono text-2xs text-faint">
        &copy; {year} {SITE.name} — Made with too much coffee in {place}.
      </p>
    </Container>
  </div>
</footer>
