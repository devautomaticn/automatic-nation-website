---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
// Normalised base with no trailing slash — matches how the physics script
// builds each src (B + '/logos/...'), so the preload URL is identical and the
// browser reuses the same fetch instead of requesting the icon twice.
const basePrefix = base.endsWith('/') ? base.slice(0, -1) : base;

// Well icons. Preloaded in <head> so they're fetched during initial parse (in
// parallel) and decoded before the first piece falls — otherwise cells land as
// blank tiles and the icon pops in afterwards.
// Manually mirrors LOGOS + PHOTOS in src/scripts/tetris.js — edit both.
const heroAssets = [
  'logos/Symbol.svg.svg',
  'logos/make_symbol.svg.svg',
  'logos/mondaycom_symbol.svg.svg',
  'logos/zapier_logo.svg.svg',
  'logos/airtable_symbol.svg.svg',
  'logos/calude.svg',
  'logos/n8n.svg',
  'logos/notion.svg',
  'logos/open.svg',
  'logos/vercel.svg',
  'logos/Google Gemini.svg.svg',
  'logos/Google Mail.svg.svg',
  'logos/git.svg',
  'image.png',
  'T024D9G3RV4-U05ENL69F37-458b1cdf045b-512.jpg',
];

// ── Static tetromino decorations for the closing CTA ──
// Same seven shapes, same 12px fused-corner rule and same hairline as the
// well, but no logos and no motion. Positions are multiples of the 56px cell
// so the pieces land on the section's background grid; the negative offsets
// are exactly one cell, so even the bleed stays on a grid line.
const TT_CELL = 56, TT_RADIUS = 12;
const TT_SHAPES = {
  I: [[0,0],[1,0],[2,0],[3,0]],
  O: [[0,0],[1,0],[0,1],[1,1]],
  T: [[0,0],[1,0],[2,0],[1,1]],
  S: [[1,0],[2,0],[0,1],[1,1]],
  J: [[0,0],[0,1],[1,1],[2,1]],
};
// A corner rounds only where both of its edges face outward, so cells inside a
// piece fuse — identical to Tetris.prototype.radii in src/scripts/tetris.js.
function ttRadii(cells: number[][], i: number) {
  const has = (x: number, y: number) => cells.some(c => c[0] === x && c[1] === y);
  const [x, y] = cells[i];
  return [
    (!has(x, y - 1) && !has(x - 1, y)) ? TT_RADIUS : 0,
    (!has(x, y - 1) && !has(x + 1, y)) ? TT_RADIUS : 0,
    (!has(x, y + 1) && !has(x + 1, y)) ? TT_RADIUS : 0,
    (!has(x, y + 1) && !has(x - 1, y)) ? TT_RADIUS : 0,
  ].map(v => v + 'px').join(' ');
}
const TT_LEFT = [
  { s: 'O', c: '#8699F7', x: -56, y:   0 },
  { s: 'J', c: '#7BB784', x:  56, y: 168 },
  { s: 'S', c: '#EEAF79', x: -56, y: 336 },
];
const TT_RIGHT = [
  { s: 'T', c: '#E3662E', x:  56, y:  56 },
  { s: 'I', c: '#F7DB55', x:  56, y: 224 },
  { s: 'O', c: '#8699F7', x: 112, y: 504 },
];

// ── Process timeline (Gantt) ──
// One source for both renderings: the Gantt on lg+ and the stacked cards
// below it. Duplicating this prose in two markup blocks is how the two drift
// apart, so both are generated from here.
// Everything is measured in weeks: `w` is the starting week (0-indexed) and
// `ws` how many weeks it lasts. Lanes, pills and task lists are all derived
// from those two numbers with the same formula, so a pill lines up with its
// lane by construction rather than by two sets of numbers agreeing. (This
// replaced a 24-column grid whose lines fell a few pixels off the lanes.)
const PROCESS = [
  {
    n: '01', name: 'Discovery', when: 'Week 0', w: 0, ws: 1,
    body: '30 minutes. We map your current tools, the bottlenecks, and what "done" looks like. You leave with a written scope and fixed price.',
    tasks: ['Discovery call', 'Tools & bottlenecks', 'Written scope', 'Fixed price'],
  },
  {
    n: '02', name: 'Build', when: 'Weeks 1–3', w: 1, ws: 3,
    body: 'We build the system on Airtable + n8n + your existing stack. You see weekly demo videos; nothing is built in a vacuum.',
    tasks: ['System build', 'Weekly demo videos', 'Integration testing'],
  },
  {
    n: '03', name: 'Launch', when: 'Week 4', w: 4, ws: 1, hl: true,
    body: 'We deploy live, train your team, and ship documentation written for humans, not engineers.',
    tasks: ['Deploy live', 'Team training', 'Documentation'],
  },
  {
    n: '04', name: 'Maintain', when: 'Ongoing', w: 5, ws: 1,
    body: 'Optional retainer for changes, monitoring, and the next system. Most clients stay.',
    tasks: ['Monitoring', 'Changes & fixes', 'Next system'],
  },
];
// One rounded lane per week, and one axis label centred under each. Both are
// driven off the same index so a label can never drift off its lane.
// `buffer` marks contingency weeks: the work is scoped to finish before them,
// and they exist only in case it doesn't. They're hatched and labelled rather
// than just greyed — an unexplained different-looking lane reads as a styling
// slip, not as a schedule fact.
const GANTT_TICKS = [
  { t: 'Week 0' },
  { t: 'Week 1' },
  { t: 'Week 2', buffer: true },
  { t: 'Week 3', buffer: true },
  { t: 'Week 4' },
  { t: 'Ongoing' },
];

// ── FILL IN BEFORE LAUNCH ───────────────────────────────────────────────
// Scheduling link used by every "Book a call" CTA (Calendly, Cal.com, …).
// While empty, the CTAs fall back to jumping to the #book section.
const BOOKING_URL = '';
// ────────────────────────────────────────────────────────────────────────

const bookHref = BOOKING_URL || '#book';
const bookAttrs = BOOKING_URL ? { target: '_blank', rel: 'noopener' } : {};

const title = 'Automatic Nation — Automation & Integrations Agency';
const description =
  'We build custom integrations and automated workflows across Airtable, n8n, and 900+ apps. 50+ workflows shipped. Book a discovery call.';
// Absolute URLs for canonical/OG — Astro.site comes from `site` in
// astro.config.mjs, so pointing that at a custom domain updates both.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${basePrefix}/og-image.png`, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/svg+xml" href={`${basePrefix}/favicon.svg`} />
  <link rel="alternate icon" href={`${basePrefix}/favicon.ico`} />

  <!-- Social cards -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts: hero set + JetBrains Mono for section eyebrows.
       preconnect saves a round trip — the stylesheet alone can't start the
       font fetch until it has resolved and parsed. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Preload hero-canvas icons so they're decoded before the physics drop -->
  {heroAssets.map(a => <link rel="preload" as="image" href={`${basePrefix}/${a}`} />)}

</head>
<body>

<!-- ══════════════════════════════════════════ -->
<!--  NAVBAR                                    -->
<!-- ══════════════════════════════════════════ -->
<header class="navbar">
  {/* Inner container so the bottom rule stays full-bleed (like every section
      border on the page) while the contents sit on the same 1280px column as
      the hero and the sections. */}
  <div class="navbar-inner">
  <a href={base} class="logo">
    <svg width="32" height="31" viewBox="0 0 32 31" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M11.6217 0C11.7142 0.000353627 11.7891 0.0752685 11.7895 0.167763V21.8947H13.4737V12.125L20.2105 0H21.8947V21.8947H23.5789V12.125L30.3158 0H32V15.1579H30.3158L21.8947 30.3158H20.2105V15.1579L11.7895 30.3158H10.1053V15.8076C10.105 15.6342 9.87405 15.5741 9.78947 15.7253L1.73191 30.2286C1.70227 30.282 1.64653 30.3156 1.58553 30.3158H0.167763C0.0752688 30.3154 0.000354051 30.2405 0 30.148V15.3257C0.000354057 15.2332 0.0752688 15.1582 0.167763 15.1579H1.58553C1.64653 15.1577 1.70227 15.1241 1.73191 15.0707L10.0576 0.087171C10.0872 0.0338245 10.1429 0.00014998 10.2039 0H11.6217Z" fill="#2C2C2C"/>
    </svg>
    <span class="logo-text">Automatic Nation</span>
  </a>
  <nav class="nav-links" aria-label="Main">
    <a href="#templates">Use cases</a>
    <a href="#process">Process</a>
    <a href="#faq">FAQ</a>
  </nav>
  <a href={bookHref} {...bookAttrs} class="btn-cta">Book a call</a>
  </div>
</header>

<!-- ══════════════════════════════════════════ -->
<!--  HERO                                      -->
<!-- ══════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-left">
    <h1 class="headline">
      We build systems that save your team <strong>22 hours</strong> a week.
    </h1>
    <p class="hero-sub">
      We build custom integrations and automated workflows across 900+ popular platforms.
    </p>
    <p class="hero-sub2">
      First system live in under 4 weeks, fixed scope, fixed price.
    </p>
    <a href={bookHref} {...bookAttrs} class="btn-hero">
      Book a free consultation <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="hero-right">
    {/* Empty on purpose: tetris.js builds the 608×608 stage, the cell guides,
        the HUD and the NEXT preview inside this box at runtime. */}
    <div class="dot-card" data-base={base}></div>
  </div>
</section>

<!-- ══════════════════════════════════════════ -->
<!--  WHO IT'S FOR                              -->
<!-- ══════════════════════════════════════════ -->
<section id="who-its-for" class="bg-paper border-t border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
    <div class="max-w-2xl reveal">
      <p class="eyebrow text-mute mb-4">Who this is for</p>
      <h2 class="text-[clamp(32px,5vw,56px)] font-bold tracking-[-0.035em] leading-[0.95]">This pays off fastest if you're…</h2>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line border border-line reveal">
      <div class="p-8 lg:p-10">
        <p class="eyebrow text-mute mb-4">Ops teams</p>
        <h3 class="text-[18px] font-semibold tracking-[-0.02em]">Copy-pasting between 5+ tools every day</h3>
        <p class="mt-3 text-[14px] text-mute leading-relaxed">Your team knows the bottleneck. You just haven't had time to fix it. We scope it in a single call and build it in weeks — not quarters.</p>
      </div>
      <div class="p-8 lg:p-10">
        <p class="eyebrow text-mute mb-4">Founders</p>
        <h3 class="text-[18px] font-semibold tracking-[-0.02em]">Team burning &gt;10 hours/week on manual work</h3>
        <p class="mt-3 text-[14px] text-mute leading-relaxed">That's a part-time hire you're already paying for in wasted time. We give it back — on a fixed budget, without adding headcount.</p>
      </div>
      <div class="p-8 lg:p-10">
        <p class="eyebrow text-mute mb-4">Power users</p>
        <h3 class="text-[18px] font-semibold tracking-[-0.02em]">Outgrown Zapier or your DIY Airtable setup</h3>
        <p class="mt-3 text-[14px] text-mute leading-relaxed">You know the tools. You just don't have time to build the right system from scratch. We pick up where your DIY left off.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ -->
<!--  USE CASES (dark)                          -->
<!-- ══════════════════════════════════════════ -->
<section id="templates" class="bg-ink text-white dot-grid">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
    <div class="max-w-3xl reveal">
      <p class="eyebrow text-dim mb-4">What it looks like in practice</p>
      <h2 class="text-[clamp(32px,5vw,56px)] font-bold tracking-[-0.035em] leading-[0.95]">Real workflows we've built — adapt one or bring your own.</h2>
    </div>

    {/* The row bleeds to both edges (-mx-6) but the cards must line up with the
        heading, so the 24px inset lives on the flex row, not on the scroll
        container: a scroller's padding-left doesn't offset a child carrying
        min-width:max-content (the card landed at 0 while the h2 sat at 24),
        and its padding-right is dropped outright, killing the trailing gap. */}
    <div class="mt-16 -mx-6 lg:mx-0 overflow-x-auto h-snap no-scrollbar">
      <div class="flex lg:grid lg:grid-cols-4 gap-5 min-w-max lg:min-w-0 px-6 lg:px-0">

        <article class="w-[78vw] sm:w-[60vw] lg:w-auto border border-line-dk rounded-2xl p-7 bg-ink">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">HUBSPOT</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">CLEARBIT</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">SLACK</span>
          </div>
          <h3 class="mt-6 text-[20px] font-semibold tracking-[-0.02em]">Lead enrichment &amp; routing</h3>
          <p class="mt-3 text-[14px] text-dim leading-relaxed">Every new lead is auto-enriched with company data, scored, and routed to the right rep in Slack. No more "who's taking this?"</p>
          <p class="mt-8 font-mono text-[11px] text-accent">Leads routed in &lt;60 seconds</p>
        </article>

        <article class="w-[78vw] sm:w-[60vw] lg:w-auto border border-line-dk rounded-2xl p-7 bg-ink">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">AIRTABLE</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">STRIPE</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">POSTGRES</span>
          </div>
          <h3 class="mt-6 text-[20px] font-semibold tracking-[-0.02em]">Operations dashboard in Airtable</h3>
          <p class="mt-3 text-[14px] text-dim leading-relaxed">Live revenue, pipeline, and ops metrics in one Airtable view — synced from your billing system, CRM, and product database.</p>
          <p class="mt-8 font-mono text-[11px] text-accent">Revenue + pipeline: one view, always live</p>
        </article>

        <article class="w-[78vw] sm:w-[60vw] lg:w-auto border border-line-dk rounded-2xl p-7 bg-ink">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">N8N</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">OPENAI</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">GMAIL</span>
          </div>
          <h3 class="mt-6 text-[20px] font-semibold tracking-[-0.02em]">AI-drafted client updates</h3>
          <p class="mt-3 text-[14px] text-dim leading-relaxed">Project status pulled from your PM tool, summarized by an LLM, drafted as a client-ready email — sent every Friday with one click.</p>
          <p class="mt-8 font-mono text-[11px] text-accent">Friday updates drafted in 30 seconds, not 3 hours</p>
        </article>

        <article class="w-[78vw] sm:w-[60vw] lg:w-auto border border-line-dk rounded-2xl p-7 bg-ink">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">SHOPIFY</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">AIRTABLE</span>
            <span class="px-2.5 py-1 text-[10px] font-semibold tracking-wider rounded-lg border border-line-dk text-dim">QUICKBOOKS</span>
          </div>
          <h3 class="mt-6 text-[20px] font-semibold tracking-[-0.02em]">Inventory sync across channels</h3>
          <p class="mt-3 text-[14px] text-dim leading-relaxed">Stock, orders, and accounting kept in sync across three systems — no nightly CSV exports, no manual reconciliations.</p>
          <p class="mt-8 font-mono text-[11px] text-accent">Reconciliation: 4 hours/month → 0</p>
        </article>

      </div>
    </div>

    <!-- Client pull-quote placeholder -->
    {/* bg-ink is load-bearing, not decoration: without a fill the section's
        line grid shows straight through the card. Same reason the use-case
        articles above carry it. */}
    <div class="mt-14 reveal border border-line-dk rounded-2xl p-8 lg:p-10 max-w-3xl bg-ink">
      <p class="text-[18px] lg:text-[20px] font-medium leading-relaxed text-white">
        "[CLIENT QUOTE — to be filled in: one sentence on the time or money saved.]"
      </p>
      <p class="mt-5 font-mono text-[11px] text-dim">— [Name], [Role] · [Company]</p>
    </div>

    <div class="mt-10 reveal">
      <a href="#book" class="link-u text-[14px] text-dim hover:text-white">See how we'd build yours →</a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ -->
<!--  PROCESS                                   -->
<!-- ══════════════════════════════════════════ -->
<section id="process" class="bg-paper">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">

    <p class="font-mono text-[12px] text-dim tracking-wide reveal">50+ workflows shipped · ~22 hrs saved/week · &lt;4 wks first delivery</p>

    <div class="mt-8 max-w-3xl reveal">
      <p class="eyebrow text-mute mb-4">How we work</p>
      <h2 class="text-[clamp(32px,5vw,56px)] font-bold tracking-[-0.035em] leading-[0.95]">From first call to live system in under 4 weeks.</h2>
    </div>

    {/* Gantt, lg+ only. Below that it's replaced by the stacked cards below —
        a 24-column chart at phone width is unreadable, and only one of the two
        is ever in the accessibility tree since the other is display:none. */}
    <div class="gantt hidden lg:block mt-16 reveal">
      <div class="gantt-plot">
        <div class="gantt-lanes" aria-hidden="true">
          {GANTT_TICKS.map((k, i) => (
            <i class={k.buffer ? 'is-buffer' : undefined} style={`--i:${i}`}></i>
          ))}
        </div>

        <ol class="gantt-bars">
          {PROCESS.map(p => (
            <li style={`--w:${p.w};--ws:${p.ws}`}>
              <span class={`gantt-pill${p.hl ? ' gantt-pill--hl' : ''}`}>
                <b class="gantt-badge">{p.n}</b>
                <span class="gantt-pill-txt">
                  <strong>{p.name}</strong>
                  <em>{p.when}</em>
                </span>
              </span>
            </li>
          ))}
        </ol>

        <ol class="gantt-tasks">
          {PROCESS.map(p => (
            <li style={`--w:${p.w}`}>
              <span class="sr-only">{p.name} ({p.when})</span>
              <ul>{p.tasks.map(t => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>

        <div class="gantt-axis" aria-hidden="true">
          {GANTT_TICKS.map((k, i) => (
            <span class={k.buffer ? 'is-buffer' : undefined} style={`--i:${i}`}>
              {k.t}{k.buffer && <b>buffer</b>}
            </span>
          ))}
        </div>
      </div>
    </div>

    <ol class="lg:hidden mt-16 grid grid-cols-1 gap-px bg-line border border-line reveal">
      {PROCESS.map(p => (
        <li class="bg-paper p-8">
          <div class="font-mono text-[24px] font-bold text-ink">{p.n}</div>
          <h3 class="mt-4 text-[18px] font-semibold tracking-[-0.02em]">{p.name} ({p.when})</h3>
          <p class="mt-3 text-[14px] text-mute leading-relaxed">{p.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.tasks.map(t => (
              <li class="font-mono text-[11px] text-mute border border-line rounded-lg px-2 py-1">{t.t}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ══════════════════════════════════════════ -->
<!--  MID-PAGE CTA STRIP                        -->
<!-- ══════════════════════════════════════════ -->
<section class="bg-paper border-t border-b border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 reveal">
    <p class="text-[18px] font-semibold tracking-[-0.02em] max-w-lg">
      Most teams already know which workflow they'd automate first. Tell us yours.
    </p>
    <a href={bookHref} {...bookAttrs} class="cta inline-flex items-center gap-2 bg-accent hover:bg-white text-ink text-[14px] font-medium px-6 py-2.5 rounded-[14px] whitespace-nowrap">
      Book a call <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<!-- ══════════════════════════════════════════ -->
<!--  FAQ                                       -->
<!-- ══════════════════════════════════════════ -->
<section id="faq" class="bg-paper border-t border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
    <div class="max-w-3xl reveal">
      <p class="eyebrow text-mute mb-4">Common questions</p>
      <h2 class="text-[clamp(32px,5vw,56px)] font-bold tracking-[-0.035em] leading-[0.95]">What teams ask before booking.</h2>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-px bg-line border border-line reveal">
      <div class="bg-paper p-8 lg:p-10">
        <h3 class="text-[18px] font-semibold tracking-[-0.02em]">What does a project typically cost?</h3>
        <p class="mt-3 text-[14px] text-mute leading-relaxed">Pricing is fixed and scoped after the discovery call. Most projects land between <strong>[FILL IN RANGE]</strong>. No hourly billing, no scope creep, no surprises — you hear the exact number on the call.</p>
      </div>
