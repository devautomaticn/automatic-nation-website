<!-- Hero tetromino well.
     NOT is:inline: it needs Astro's bundling to resolve the import. That is
     safe now — the only reason the old hero scripts had to be inline was
     execution order against the Matter.js CDN tag, and that tag is gone. -->
<script>
  import { Tetris } from '../scripts/tetris.js';
  import { initSmoothScroll } from '../scripts/smooth-scroll.js';

  initSmoothScroll();

  const card = document.querySelector('.dot-card');
  if (card) {
    // Same BASE_URL dance as before: the module can't see import.meta.env at
    // runtime, so the base arrives via data-base and is normalised to match
    // the <link rel="preload"> URLs character for character.
    const raw = card.dataset.base || '';
    const B = raw.endsWith('/') ? raw.slice(0, -1) : raw;
    new Tetris(card, {
      // Fall speed cut 25% from the engine's 2000 default. minMs scales the
      // other way (220 / 0.75 = 293): it's a hard floor on a fall's duration,
      // so leaving it at 220 would keep short drops at their old timing while
      // only the long falls slowed down.
      cols: 10, rows: 10, size: 608, radius: 12, speed: 1500, gap: 100,
      minMs: 293,
      holdDepth: 8, holdMs: 2600, guides: true, hud: true, seed: 63,
      assetBase: B + '/',
    });
  }
</script>

<!-- Reveal-on-scroll -->
<script is:inline>
  const _revealObserver = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        _revealObserver.unobserve(e.target);
      }
    }
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => _revealObserver.observe(el));
</script>

