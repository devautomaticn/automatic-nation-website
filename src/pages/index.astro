---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTetris from '../components/heroes/HeroTetris.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import UseCases from '../components/sections/UseCases.astro';
import Process from '../components/sections/Process.astro';
import CtaStrip from '../components/sections/CtaStrip.astro';
import Faq from '../components/sections/Faq.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';

import { BASE } from '../lib/url';
import { BOOKING } from '../lib/site';
import { HERO_ASSETS } from '../lib/hero-assets';
import { PROCESS, GANTT_TICKS } from '../data/process';
import { organization, webSite, faqPage } from '../lib/jsonld';
import * as copy from '../data/landings/home';

const origin = new URL(`${BASE}/`, Astro.site).href;
const book = { href: BOOKING.href, external: BOOKING.external };
---
<BaseLayout
  title={copy.seo.title}
  description={copy.seo.description}
  preloadImages={HERO_ASSETS}
  jsonLd={[organization(origin), webSite(origin), faqPage(copy.faq.items)]}
>
  <HeroTetris sub={copy.hero.sub} sub2={copy.hero.sub2} cta={{ ...book, label: copy.hero.ctaLabel }}>
    <Fragment slot="title">
      We build systems that save your team <strong>22 hours</strong> a week.
    </Fragment>
  </HeroTetris>

  <FeatureGrid id="who-its-for" {...copy.audience} />

  <UseCases
    id="templates"
    eyebrow={copy.useCases.eyebrow}
    title={copy.useCases.title}
    items={copy.useCases.items}
    quote={copy.useCases.quote}
    link={{ ...book, label: copy.useCases.linkLabel }}
  />

  <Process id="process" {...copy.process} phases={PROCESS} ticks={GANTT_TICKS} />

  <CtaStrip text={copy.strip.text} cta={{ ...book, label: copy.strip.ctaLabel }} />

  <Faq id="faq" eyebrow={copy.faq.eyebrow} title={copy.faq.title} items={copy.faq.items} />

  <ClosingCta
    id="book"
    eyebrow={copy.closing.eyebrow}
    body={copy.closing.body}
    note={copy.closing.note}
    cta={{ ...book, label: copy.closing.ctaLabel }}
    deco={copy.closingDeco}
  >
    <Fragment slot="title">Another quarter of manual work.<br />Or one 30-minute call.</Fragment>
  </ClosingCta>
</BaseLayout>
