---
import RedirectStub from '../layouts/RedirectStub.astro';
import { pageUrl } from '../lib/url';

/**
 * Legacy WordPress URL. It now HAS an equivalent here — /book-a-call/ — so it
 * points there rather than at the home page's #book section.
 *
 * Still not straight to cal.com: an external canonical would hand the equity
 * of an indexed page to another domain, and /book-a-call/ embeds the same
 * calendar anyway.
 *
 * A stub rather than a 404 because these are in the live sitemap: a 404 throws
 * away whatever equity they carry, and Pages cannot serve a 301.
 */
---
<RedirectStub to={pageUrl('book-a-call', Astro.site)} title="Book a call" />
