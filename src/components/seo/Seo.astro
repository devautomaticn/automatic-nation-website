---
import { asset, absolute } from '../../lib/url';

/**
 * Every <head> tag that depends on the page. The only place a URL gets
 * absolutised — `Astro.site` is the bare origin, so anything built with
 * `new URL(path, Astro.site)` silently loses the deployment base.
 */
interface Props {
  title: string;
  description: string;
  /** Path with no leading slash and no base: '', 'blog', 'blog/my-post'. */
  path?: string;
  /** Path under public/. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  article?: { published: Date; modified?: Date; author?: string; tags?: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = '',
  ogImage = 'og-image.png',
  ogType = 'website',
  noindex = false,
  article,
  jsonLd,
} = Astro.props as Props;

const canonical = absolute(path, Astro.site);
const image = absolute(ogImage, Astro.site);
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
<link rel="alternate icon" href={asset('favicon.ico')} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="Automatic Nation" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{article && (
  <>
    <meta property="article:published_time" content={article.published.toISOString()} />
    {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.tags?.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

{blocks.map(block => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
